[
  {
    "server": "notion-mcp",
    "name": "get_pages",
    "description": "Get pages from a Notion database.",
    "input_schema": {
      "type": "object",
      "properties": {
        "database_id": { "type": "string" }
      },
      "required": ["database_id"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "meta_description": { "type": "string" }
            }
          }
        }
      }
    }
  },
  {
    "server": "wordpress-mcp",
    "name": "create_draft",
    "description": "Create a draft post on WordPress.",
    "input_schema": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["title"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "post_id": { "type": "string" },
        "slug": { "type": "string" },
        "url": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  },
  {
    "server": "wordpress-mcp",
    "name": "get_page",
    "description": "Fetch a WordPress draft/page before QA.",
    "input_schema": {
      "type": "object",
      "properties": {
        "post_id": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  {
    "server": "wordpress-mcp",
    "name": "get_links",
    "description": "Extract and return links from a draft body.",
    "input_schema": {
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "links": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  {
    "server": "wordpress-mcp",
    "name": "publish_post",
    "description": "Publish a WordPress post after QA approval or auto-publish.",
    "input_schema": {
      "type": "object",
      "properties": {
        "post_id": { "type": "string" },
        "qa_passed": { "type": "boolean" },
        "url": { "type": "string" }
      },
      "required": ["post_id"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "url": { "type": "string" }
      }
    }
  },
  {
    "server": "qa-gate",
    "name": "run_check",
    "description": "Run the AI Draft-to-Publish QA Gate before publishing.",
    "input_schema": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "meta_description": { "type": "string" },
        "content": { "type": "string" },
        "draft_url": { "type": "string" },
        "post_id": { "type": "string" },
        "target_audience": { "type": "string" },
        "brand_rubric": { "type": "string" },
        "internal_links": { "type": "array", "items": { "type": "string" } },
        "mode": { "type": "string", "enum": ["manual_approval", "auto_publish", "send_to_editor"] },
        "override": { "type": "boolean" }
      },
      "required": ["title", "content"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "pass": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "status": { "type": "string" },
        "score": { "type": "integer" },
        "reasoning": { "type": "string" },
        "suggestions": { "type": "array", "items": { "type": "string" } },
        "next_action": { "type": "string" }
      }
    }
  },
  {
    "server": "slack-mcp",
    "name": "post_message",
    "description": "Post a message to a Slack channel.",
    "input_schema": {
      "type": "object",
      "properties": {
        "channel": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["channel", "text"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      }
    }
  },
  {
    "server": "resend-mcp",
    "name": "send_email",
    "description": "Send an email via Resend.",
    "input_schema": {
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "to": { "type": "string" },
        "from": { "type": "string" }
      },
      "required": ["subject", "body"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  }
]
