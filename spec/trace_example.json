{
  "name": "Live run trace example",
  "description": "Example of GET /mcp/resources/runs/{run_id}/trace output showing steps in progress",
  "endpoint": "GET /mcp/resources/runs/run-12345-abc/trace",
  "response_at_start": {
    "run_id": "run-12345-abc",
    "workflow": "notion-to-content-stack",
    "status": "in_progress",
    "steps": [
      {
        "step_index": 0,
        "server": "wordpress-mcp",
        "tool": "create_draft",
        "status": "in_progress",
        "tool_call": {
          "name": "create_draft",
          "input": {
            "title": "Editorial Calendar Page",
            "content": "Content for the editorial calendar page."
          }
        },
        "tool_result": null,
        "error": null
      },
      {
        "step_index": 1,
        "server": "slack-mcp",
        "tool": "post_message",
        "status": "pending",
        "tool_call": null,
        "tool_result": null,
        "error": null
      },
      {
        "step_index": 2,
        "server": "resend-mcp",
        "tool": "send_email",
        "status": "pending",
        "tool_call": null,
        "tool_result": null,
        "error": null
      }
    ]
  },
