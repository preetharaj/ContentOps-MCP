    "workflow": "notion-to-content-stack",
    "status": "in_progress",
    "steps": [
      {
        "step_index": 0,
        "server": "wordpress-mcp",
        "tool": "create_draft",
        "status": "completed",
        "tool_call": {
          "name": "create_draft",
          "input": {
            "title": "Editorial Calendar Page",
            "content": "Content for the editorial calendar page."
          }
        },
        "tool_result": {
          "tool": "create_draft",
          "output": {
            "slug": "editorial-calendar-page",
            "url": "https://example.com/draft/editorial-calendar-page"
          },
          "error": null
        },
        "error": null
      },
      {
        "step_index": 1,
        "server": "slack-mcp",
        "tool": "post_message",
        "status": "in_progress",
        "tool_call": {
          "name": "post_message",
          "input": {
            "channel": "#content-team",
            "text": "New draft published: https://example.com/draft/editorial-calendar-page"
          }
        },
        "tool_result": null,
        "error": null
      },
      {
        "step_index": 2,
        "server": "resend-mcp",
        "tool": "send_email",
        "status": "pending",
        "tool_call": null,
        "tool_result": null,
        "error": null
      }
    ]
